# Environment Configuration Template for NIFTY & BEYOND
# NEVER commit the actual .env file containing secrets.

# Production Safety Switch (Must be "true" to allow database writes; defaults to "false")
PRODUCTION_INGEST_ENABLED=false

# Expected Supabase Project Reference
EXPECTED_PROJECT_REF=post-market-app

# Supabase / PostgreSQL Credentials
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Source Directories (Read-Only)
EOD_REPORT_PATH=D:\Anti Gravity\post-market-report\reports\rendered
SECTOR_REPORT_PATH=D:\Anti Gravity\stock-reports-with-Antigravity\outputs
